@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ResearchProjectManager.Models
@using ResearchProjectManager.Enums
@inject ApplicationDbContext _context
@inject UserManager<User> UserManager

@*Cookie Management for navigation bar*@
@{
    string courseColor = string.Empty;
    string? activeCourseId = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        string? userIdString = UserManager.GetUserId(User);

        if (int.TryParse(userIdString, out int userId))
        {
            activeCourseId = Context.Items["ActiveCourseId"]?.ToString() ?? Context.Request.Cookies[$"ActiveCourseId_{userIdString}"];

            if (!string.IsNullOrEmpty(activeCourseId) && int.TryParse(activeCourseId, out int parsedId))
            {
                Course? course = _context.Courses
                    .Include(c => c.Members)
                    .FirstOrDefault(c => c.Id == parsedId);

                if (course != null)
                {
                    bool hasAccess = (course.OwnerId == userId ||
                                    course.Members.Any(m => m.UserId == userId) ||
                                    !course.IsPrivate);
                    if (hasAccess)
                    {
                        courseColor = CourseTheme.Colors.ContainsKey(course.Color) ? CourseTheme.Colors[course.Color] : "#0d6efd";
                    }
                    else
                    {
                        ResearchProjectManager.Helper.CookieHelper.ClearActiveCourseCookie(Context.Response, Context.Items, userIdString);
                        activeCourseId = null;
                    }
                }
                else
                {
                    // The course was deleted so destroy the ghost cookie
                    ResearchProjectManager.Helper.CookieHelper.ClearActiveCourseCookie(Context.Response, Context.Items, userIdString);
                    activeCourseId = null;
                }
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResearchProjectManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ResearchProjectManager.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            .custom-navbar {
                background: rgba(255, 255, 255, 0.98) !important;
                backdrop-filter: blur(10px);
            }

            .custom-nav-link {
                transition: color 0.2s ease, transform 0.2s ease;
                position: relative;
            }

                .custom-nav-link:hover {
                    color: #0d6efd !important;
                    transform: translateY(-1px);
                }

            .custom-nav-pill {
                transition: background-color 0.2s ease, box-shadow 0.2s ease;
            }

                .custom-nav-pill:hover {
                    background-color: #f8f9fa !important;
                    box-shadow: 0 4px 6px rgba(0,0,0,0.05) !important;
                }

            .custom-logout-btn {
                transition: all 0.2s ease;
            }

                .custom-logout-btn:hover {
                    background-color: #fee2e2;
                    color: #dc3545 !important;
                }

            .custom-hover-link:hover {
                color: #2D3748 !important;
            }
            /* Forces uniform width for course navigation tabs so they look clean and balanced */
            .uniform-nav-item {
                width: 150px;
                text-align: center;
            }
    </style>
</head>
<body style="padding-bottom: 30px; background-color: #f8fafc;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light custom-navbar border-bottom shadow-sm py-1 mb-4">
            <div class="container-fluid ms-3 me-1">

                <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2 me-4" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;">
                        <i class="bi bi-layers-half fs-5"></i>
                    </div>
                    <span style="letter-spacing: -0.5px;">ProjectManager</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center gap-1">

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium custom-nav-link text-secondary" asp-controller="AdminPanel" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i> Admin Panel
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Instructor") || User.IsInRole("Student") || User.IsInRole("TA"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold custom-nav-link text-dark" asp-controller="Course" asp-action="Index">
                                    <i class="bi bi-journal-bookmark me-1"></i> Courses
                                </a>
                            </li>

                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold custom-nav-link text-dark" asp-controller="TaskAssignment" asp-action="AllMyAssignments">
                                        <i class="bi bi-journal-text me-1"></i> My Assignments
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link fw-medium custom-nav-link text-secondary" asp-controller="Course" asp-action="FindMore">
                                    <i class="bi bi-compass me-1"></i> Find Courses
                                </a>
                            </li>

                            

                            @if (!string.IsNullOrEmpty(activeCourseId))
                            {
                                <li class="nav-item d-none d-lg-flex align-items-center mx-2">
                                    <span class="text-muted opacity-25">|</span>
                                </li>

                                
                                <li class="nav-item uniform-nav-item">
                                    <a class="nav-link fw-medium text-dark px-3 py-2 custom-nav-link d-block text-truncate"
                                       style="border-bottom: 3px solid @courseColor;"
                                       asp-controller="Course"
                                       asp-action="Details"
                                       asp-route-id="@activeCourseId">
                                        <i class="bi bi-house-door me-1"></i> Overview
                                    </a>
                                </li>

                                if (User.IsInRole("Instructor") || User.IsInRole("TA"))
                                {
                                    <li class="nav-item uniform-nav-item">
                                        <a class="nav-link fw-medium text-dark px-3 py-2 custom-nav-link d-block text-truncate"
                                           style="border-bottom: 3px solid @courseColor;"
                                           asp-controller="ProjectTask"
                                           asp-action="Index"
                                           asp-route-courseId="@activeCourseId">
                                            <i class="bi bi-file-earmark-text me-1"></i> Tasks
                                        </a>
                                    </li>
                                }

                                    @if (User.IsInRole("Student"))
                                    {
                                        <li class="nav-item uniform-nav-item">
                                            <a class="nav-link fw-medium text-dark px-3 py-2 custom-nav-link d-block text-truncate"
                                            style="border-bottom: 3px solid @courseColor;"
                                            asp-controller="TaskAssignment"
                                            asp-action="MyCourseAssignments"
                                            asp-route-courseId="@activeCourseId">
                                                <i class="bi bi-clipboard-check me-1"></i> Assignments
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                    <li class="nav-item uniform-nav-item">
                                        <a class="nav-link fw-medium text-dark px-3 py-2 custom-nav-link d-block text-truncate"
                                           style="border-bottom: 3px solid @courseColor;"
                                           asp-controller="TaskAssignment"
                                           asp-action="Index"
                                           asp-route-courseId="@activeCourseId">
                                            <i class="bi bi-clipboard-check me-1"></i> Assignments
                                        </a>
                                    </li>
                                    }

                                <li class="nav-item uniform-nav-item">
                                    <a class="nav-link fw-medium text-dark px-3 py-2 custom-nav-link d-block text-truncate"
                                       style="border-bottom: 3px solid @courseColor;"
                                       asp-controller="Course"
                                       asp-action="Members"
                                       asp-route-courseId="@activeCourseId">
                                        <i class="bi bi-people me-1"></i> Members
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light shadow-sm fixed-bottom" style="padding: 10px 0;">
        <div class="container-fluid mx-2 d-flex flex-wrap justify-content-between align-items-center">
            <div class="col-md-4 d-flex align-items-center">
                <span class="mb-0 text-white-50 fw-semibold">&copy; <span style="visibility:hidden">@@</span>ResearchProjectManager</span>
            </div>

            <div class="col-md-4 d-flex align-items-center justify-content-end text-white-50">
                <span id="live-clock" class="mb-0 mx-4"></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function updateClock() {
                const now = new Date();
                const options = {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                };
                document.getElementById('live-clock').textContent = now.toLocaleDateString(undefined, options);
            }
            updateClock();
            setInterval(updateClock, 1000);
    </script>
</body>
</html>