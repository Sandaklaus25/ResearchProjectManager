@using ResearchProjectManager.Enums
@model ResearchProjectManager.ViewModels.TaskAssignmentDetailsViewModel

@{
    ViewData["Title"] = Model.Assignment.Name;
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-action="@Model.BackAction" asp-route-courseId="@Model.CourseId" class="text-decoration-none text-muted fw-medium custom-hover-link">
            <i class="bi bi-arrow-left me-1"></i> Back to Assignments
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm flex-shrink-0" style="width: 48px; height: 48px; background-color: @Model.ThemeColor; color: white;">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-dark mb-1">
                            @Model.Assignment.Name
                            @if (Model.Assignment.Task != null)
                            {
                                <span class="text-muted fw-normal opacity-75" style="font-size: 1.5rem;">| @Model.Assignment.Task.Name</span>
                            }
                        </h2>
                        <div class="text-muted small fw-medium d-flex align-items-center flex-wrap gap-3">
                            <span><i class="bi bi-calendar-event me-1"></i> Due: @Model.Assignment.Deadline.ToString("MMM dd, yyyy HH:mm")</span>

                            <div class="dropdown">
                                <a href="#" class="text-decoration-none text-muted dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-people-fill me-1"></i> @Model.Assignment.Team?.Name
                                </a>
                                <ul class="dropdown-menu shadow-sm border-0 mt-2 p-2 rounded-3" style="min-width: 200px;">
                                    <li><h6 class="dropdown-header fw-bold text-dark px-2 py-1">Team Members</h6></li>
                                    @if (Model.Assignment.Team?.UserTeams != null && Model.Assignment.Team.UserTeams.Any())
                                    {
                                        foreach (var ut in Model.Assignment.Team.UserTeams)
                                        {
                                            <li><div class="dropdown-item-text small px-2 py-1"><i class="bi bi-person-circle me-2 text-muted"></i>@ut.User?.UserName</div></li>
                                        }
                                    }
                                    else
                                    {
                                        <li><div class="dropdown-item-text small text-muted px-2 py-1">No active members</div></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <h6 class="fw-bold text-dark mb-3">Task Description</h6>
                @if (Model.Assignment.Task != null && !string.IsNullOrWhiteSpace(Model.Assignment.Task.Description))
                {
                    <div class="bg-white border rounded-3 p-4 shadow-sm text-dark text-break" style="white-space: pre-wrap; font-size: 0.95rem;">@Model.Assignment.Task.Description</div>
                }
                else
                {
                    <div class="bg-white border rounded-3 p-4 shadow-sm text-muted fst-italic">
                        No additional instructions provided.
                    </div>
                }
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Assignment Steps</h5>

                    <a asp-action="ManageSubtasks" asp-route-id="@Model.Assignment.Id" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-outline-secondary rounded-pill fw-medium shadow-sm">
                        <i class="bi bi-kanban me-1"></i> Open Subtasks Board
                    </a>
                </div>

                @if (Model.Assignment.Subtasks != null && Model.Assignment.Subtasks.Any())
                {
                    <div class="list-group list-group-flush border-top border-bottom">
                        @foreach (var step in Model.Assignment.Subtasks)
                        {
                            bool isDone = step.Status == ResearchProjectManager.Enums.TaskStatus.Completed || step.Status == ResearchProjectManager.Enums.TaskStatus.Cancelled;

                            <div class="list-group-item d-flex align-items-start py-3 px-0 border-light bg-transparent">
                                <div class="me-3 mt-1" style="color: @(isDone ? Model.ThemeColor : "#adb5bd");">
                                    <i class="bi @(isDone ? "bi-check-circle-fill" : "bi-circle") fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold @(isDone ? "text-muted text-decoration-line-through" : "text-dark")">@step.Name</h6>
                                    @if (!string.IsNullOrWhiteSpace(step.Description))
                                    {
                                        <p class="mb-0 text-muted small @(isDone ? "text-decoration-line-through opacity-75" : "")">@step.Description</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small"><i class="bi bi-dash"></i> No specific steps defined.</p>
                }
            </div>
        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">Student Work</h5>
                        <div class="d-flex align-items-center gap-2">
                            @if (!Model.IsStudent)
                            {
                                @if (Model.Assignment.Grade.HasValue)
                                {
                                    <span class="badge bg-success text-white rounded-pill"><i class="bi bi-award me-1"></i>@Model.Assignment.Grade /100</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white rounded-pill">Not Graded</span>
                                }
                            }
                            <span class="badge @(Model.Assignment.TaskStatus == ResearchProjectManager.Enums.TaskStatus.Completed ? "bg-success" : (Model.Assignment.TaskStatus == ResearchProjectManager.Enums.TaskStatus.InProgress ? "bg-primary" : "bg-warning text-dark")) rounded-pill">
                                @Model.Assignment.TaskStatus.GetTaskStatusName()
                            </span>
                        </div>
                    </div>

                    @if (Model.IsInstructorOrTA)
                    {
                        <div class="bg-light p-3 rounded-3 border mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="small fw-bold text-dark"><i class="bi bi-award me-1" style="color: @Model.ThemeColor;"></i> Grade Assignment</span>
                            </div>

                            <form asp-controller="TaskAssignment" asp-action="GradeAssignment" method="post" class="m-0">
                                <input type="hidden" name="id" value="@Model.Assignment.Id" />
                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                <div class="input-group input-group-sm shadow-sm mb-2">
                                    <span class="input-group-text bg-white fw-bold text-muted">Score</span>
                                    <input type="number" name="grade" class="form-control text-center fw-bold bg-white" placeholder="0-100" min="0" max="100" value="@Model.Assignment.Grade" required />
                                    <span class="input-group-text bg-white text-muted">/100</span>
                                    <button type="submit" class="btn btn-success fw-bold px-3">Save</button>
                                </div>
                            </form>

                            @if (Model.Assignment.Grade.HasValue)
                            {
                                <form asp-controller="TaskAssignment" asp-action="RemoveGrade" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@Model.Assignment.Id" />
                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold py-1.5 shadow-sm" onclick="return confirm('Are you sure you want to remove this grade?');">
                                        <i class="bi bi-trash3 me-1"></i> Remove Grade
                                    </button>
                                </form>
                            }
                        </div>
                    }
                    else if (Model.Assignment.Grade.HasValue)
                    {
                        <div class="alert alert-success py-2 border-0 small text-center mb-2 rounded-3 fw-bold">
                            <i class="bi bi-award me-1"></i> Grade: @Model.Assignment.Grade /100
                        </div>
                    }

                    @if (Model.Assignment.TaskStatus == ResearchProjectManager.Enums.TaskStatus.Completed)
                    {
                        <div class="alert alert-success border-0 small text-center mb-3 rounded-3">
                            <i class="bi bi-check-circle-fill me-1"></i> Turned in on @Model.Assignment.CompletedAt?.ToString("MMM dd, HH:mm")
                        </div>

                        @if (Model.Assignment.TurnInAttachments != null && Model.Assignment.TurnInAttachments.Any())
                        {
                            <div class="mb-3">
                                <h6 class="small fw-bold text-muted mb-2">Submitted Files:</h6>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in Model.Assignment.TurnInAttachments)
                                    {
                                        <div class="border rounded-3 p-2 bg-light d-flex align-items-center shadow-sm custom-hover-link" style="cursor: pointer;" onclick="window.open('@file.FilePath', '_blank')">
                                            <div class="me-2 rounded d-flex justify-content-center align-items-center flex-shrink-0" style="width: 32px; height: 32px; background-color: rgba(0,0,0,0.05); color: @Model.ThemeColor;">
                                                <i class="bi bi-file-earmark-check"></i>
                                            </div>
                                            <div class="flex-grow-1 overflow-hidden me-3">
                                                <div class="small fw-bold text-dark text-truncate" title="@file.FileName">@file.FileName</div>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <a href="@file.FilePath" download="@file.FileName" class="btn btn-sm text-white px-2 py-1 border-0 position-relative" style="background-color: @Model.ThemeColor; z-index: 2;" title="Download file" onclick="event.stopPropagation();">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.IsStudent)
                        {
                            <form asp-action="Unsubmit" method="post">
                                <input type="hidden" name="id" value="@Model.Assignment.Id" />
                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                <button type="submit" class="btn w-100 fw-bold rounded-pill btn-outline-secondary py-2">
                                    Unsubmit Work
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        @if (Model.IsStudent)
                        {
                            <form asp-action="TurnIn" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="id" value="@Model.Assignment.Id" />
                                <input type="hidden" name="courseId" value="@Model.CourseId" />

                                @if (Model.AllStepsFinished)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted">Attach Files</label>
                                        <input type="file" name="turnInFiles" class="form-control form-control-sm" multiple accept="*/*" max="3" />
                                    </div>
                                }

                                <button type="submit" class="btn w-100 fw-bold rounded-pill text-white py-2"
                                        style="background-color: @Model.ThemeColor;"
                                    @(Model.AllStepsFinished ? "" : "disabled")>
                                    Turn In
                                </button>
                            </form>

                            @if (!Model.AllStepsFinished)
                            {
                                <p class="text-danger small text-center mt-2 mb-0">
                                    <i class="bi bi-info-circle"></i> You must complete all steps before turning in.
                                </p>
                            }
                        }
                        else
                        {
                            <div class="alert alert-secondary border-0 small text-center mb-0 rounded-3">
                                <i class="bi bi-hourglass-split me-1"></i> Awaiting student submission.
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-left-text me-2" style="color: @Model.ThemeColor;"></i> Assignment Chat</h6>
                </div>

                <div class="card-body p-4">
                    <div class="chat-history overflow-auto mb-3 pe-2" style="max-height: 400px;">
                        @if (Model.Assignment.Comments != null && Model.Assignment.Comments.Any())
                        {
                            @foreach (var comment in Model.Assignment.Comments.OrderBy(c => c.CreatedAt))
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <strong class="small text-dark">@(comment.User?.UserName ?? "Unknown")</strong>
                                        <small class="text-muted" style="font-size: 0.7rem;">@comment.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(comment.CommentText))
                                    {
                                        <div class="bg-light p-2 rounded-3 small text-dark mb-1">
                                            @comment.CommentText
                                        </div>
                                    }

                                    @if (comment.Attachments != null && comment.Attachments.Any())
                                    {
                                        <div class="d-flex flex-column gap-2 mt-2">
                                            @foreach (var file in comment.Attachments)
                                            {
                                                <div class="border rounded-3 p-2 bg-white d-flex align-items-center shadow-sm custom-hover-link" style="cursor: pointer;" onclick="window.open('@file.FilePath', '_blank')">
                                                    <div class="me-2 rounded d-flex justify-content-center align-items-center flex-shrink-0" style="width: 32px; height: 32px; background-color: rgba(0,0,0,0.05); color: @Model.ThemeColor;">
                                                        <i class="bi bi-file-earmark-text"></i>
                                                    </div>
                                                    <div class="flex-grow-1 overflow-hidden me-3">
                                                        <div class="small fw-bold text-dark text-truncate" title="@file.FileName">@file.FileName</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small text-center my-4 fst-italic">No comments yet. Start the conversation!</p>
                        }
                    </div>

                    <form id="chatForm" asp-action="AddComment" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="assignmentId" value="@Model.Assignment.Id" />
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <div class="border rounded-3 p-2 bg-light">
                            <div id="fileChipsContainer" class="d-flex flex-wrap gap-2 mb-2 px-1"></div>
                            <textarea name="commentText" class="form-control border-0 bg-transparent shadow-none small mb-2" rows="2" placeholder="Add a comment..."></textarea>

                            <div class="d-flex justify-content-between align-items-center">
                                <label class="btn btn-sm btn-outline-secondary rounded-circle ms-1 p-0 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; cursor: pointer;" title="Attach up to 3 files">
                                    <i class="bi bi-paperclip"></i>
                                    <input type="file" id="multiFileInput" class="d-none" multiple accept="*/*" />
                                </label>

                                <input type="file" name="attachmentFiles" id="formSubmissionFiles" class="d-none" multiple />

                                <button type="submit" class="btn btn-sm text-white rounded-pill px-3 shadow-sm fw-bold" style="background-color: @Model.ThemeColor;">
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .custom-hover-link {
        transition: all 0.2s;
    }

        .custom-hover-link:hover {
            border-color: #adb5bd !important;
            background-color: #f8fafc !important;
        }

    .chat-history::-webkit-scrollbar {
        width: 6px;
    }

    .chat-history::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .chat-history::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 4px;
    }

        .chat-history::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
</style>

<script>
    const dt = new DataTransfer();
    const multiFileInput = document.getElementById('multiFileInput');
    const formSubmissionFiles = document.getElementById('formSubmissionFiles');
    const chipsContainer = document.getElementById('fileChipsContainer');
    const MAX_FILES = 3;

        if (multiFileInput) {
        multiFileInput.addEventListener('change', function() {
            for (let file of this.files) {
                if (dt.items.length >= MAX_FILES) {
                    alert(`You can only attach up to ${MAX_FILES} files per message.`);
                    break;
                    }
                dt.items.add(file);
                }
            updateFilesAndUI();
            multiFileInput.value = '';
            });
        }

        function removeFile(index) {
        dt.items.remove(index);
        updateFilesAndUI();
        }

        function updateFilesAndUI() {
        formSubmissionFiles.files = dt.files;
        chipsContainer.innerHTML = '';

            Array.from(dt.files).forEach((file, index) => {
            chipsContainer.innerHTML += `
                        <div class="badge bg-secondary d-flex align-items-center py-1 px-2 rounded-pill shadow-sm">
                                <i class="bi bi-file-earmark me-1"></i>
                                <span class="text-truncate me-2" style="max-width: 120px; font-weight: 500;">${file.name}</span>
                                <i class="bi bi-x-circle-fill text-light" style="cursor: pointer;" onclick="removeFile(${index})"></i>
                            </div>
                        `;
            });
        }

        const chatHistory = document.querySelector('.chat-history');
    if (chatHistory) {
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }
</script>