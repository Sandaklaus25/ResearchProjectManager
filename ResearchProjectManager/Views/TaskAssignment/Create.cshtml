@model ResearchProjectManager.ViewModels.AssignTaskViewModel

@{
    ViewData["Title"] = "Create Assignment";
}

<div class="container mt-4 mb-5" style="max-width: 700px;">
    <div class="mb-3">
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="text-decoration-none text-muted fw-medium small">
            <i class="bi bi-arrow-left me-1"></i> Back to Assignments
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-3" style="@("border-top: 8px solid " + Model.ThemeColor + " !important;")">
        <div class="card-body p-3 p-md-4">

            <div class="text-center mb-3 pb-2 border-bottom">
                <h4 class="fw-bold text-dark mb-1">Dispatch Assignment</h4>
                <p class="text-muted mb-2 small">Configure and deploy a task to your students.</p>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CourseId" />

                <div class="mb-3 bg-white p-3 rounded-3 border shadow-sm">
                    <label asp-for="ProjectTaskId" class="form-label fw-semibold text-dark mb-1 small">
                        <i class="bi bi-journal-text me-1" style="@("color: " + Model.ThemeColor + ";")"></i> Select Project Task <span class="text-danger">*</span>
                    </label>
                    <select asp-for="ProjectTaskId" class="form-select shadow-none border-secondary border-opacity-25" required>
                        <option value="">-- Choose the task to dispatch --</option>
                        @if (Model.AvailableTasks != null)
                        {
                            @foreach (var task in Model.AvailableTasks)
                            {
                                <option value="@task.Id">@task.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ProjectTaskId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3 bg-light p-3 rounded-3 border">
                    <label asp-for="Deadline" class="form-label fw-semibold text-dark mb-1 small">
                        <i class="bi bi-calendar-event me-1"></i> Due Date & Time <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Deadline" type="datetime-local" class="form-control shadow-none border-secondary border-opacity-25" required />
                    <span asp-validation-for="Deadline" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark mb-2 small">How should this be assigned?</label>
                    <div class="d-flex flex-column flex-md-row gap-2">

                        <div class="form-check custom-radio-card flex-fill border rounded-3 p-2 text-center position-relative" style="cursor: pointer;" onclick="document.getElementById('radioNew').click();">
                            <input class="form-check-input position-absolute top-50 start-0 ms-3 mt-0 translate-middle-y" type="radio" asp-for="AssignmentMethod" value="NewTeam" id="radioNew" checked>
                            <label class="form-check-label fw-bold stretched-link w-100 ps-4 small" for="radioNew">
                                <i class="bi bi-people-fill d-block fs-4 mb-1" style="@("color: " + Model.ThemeColor + ";")"></i>
                                Create Custom Group
                            </label>
                        </div>

                        <div class="form-check custom-radio-card flex-fill border rounded-3 p-2 text-center position-relative" style="cursor: pointer;" onclick="document.getElementById('radioExisting').click();">
                            <input class="form-check-input position-absolute top-50 start-0 ms-3 mt-0 translate-middle-y" type="radio" asp-for="AssignmentMethod" value="ExistingTeam" id="radioExisting">
                            <label class="form-check-label fw-bold stretched-link w-100 ps-4 small" for="radioExisting">
                                <i class="bi bi-collection-fill d-block fs-4 mb-1" style="@("color: " + Model.ThemeColor + ";")"></i>
                                Use Existing Team
                            </label>
                        </div>
                    </div>
                </div>

                <div id="newTeamPanel" class="border rounded-4 p-3 mb-4 bg-white shadow-sm">
                    <h6 class="fw-bold mb-3"><i class="bi bi-person-plus me-2 text-muted"></i>Build a New Group</h6>

                    <div class="mb-3">
                        <label asp-for="NewTeamName" class="form-label text-muted small fw-medium">Group Name (Optional)</label>
                        <input asp-for="NewTeamName" class="form-control form-control-sm shadow-none" placeholder="e.g., Alpha Squad" />
                    </div>

                    <label class="form-label text-muted small fw-medium">Select Students <span class="text-danger">*</span></label>
                    <div class="row row-cols-1 row-cols-md-2 g-2 custom-scroll px-1 pb-1">
                        @if (Model.AvailableStudents != null)
                        {
                            @foreach (var student in Model.AvailableStudents)
                            {
                                <div class="col">
                                    <div class="form-check border rounded-3 p-2 d-flex align-items-center custom-check-row">
                                        <input class="form-check-input m-0 me-2" type="checkbox" name="SelectedStudentIds" value="@student.Id" id="student_@student.Id">
                                        <label class="form-check-label flex-grow-1 small" for="student_@student.Id" style="cursor: pointer;">
                                            @student.UserName
                                        </label>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <span asp-validation-for="SelectedStudentIds" class="text-danger small mt-1 d-block"></span>
                </div>

                <div id="existingTeamPanel" class="border rounded-4 p-3 mb-4 bg-white shadow-sm" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2 text-muted"></i>Select a Team</h6>

                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill fw-medium px-3 shadow-sm" onclick="attemptTeamDelete()">
                            <i class="bi bi-trash3 me-1"></i> Delete Team
                        </button>
                    </div>

                    <select asp-for="SelectedTeamId" id="teamSelectDropdown" class="form-select shadow-none border-secondary border-opacity-25">
                        <option value="">-- Choose an established team --</option>
                        @if (Model.AvailableTeams != null)
                        {
                            @foreach (var team in Model.AvailableTeams)
                            {
                                <option value="@team.Id">@team.Name (@team.UserTeams.Count members)</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary btn-sm rounded-pill fw-medium px-4 py-2">Cancel</a>
                    <button type="submit" class="btn btn-sm rounded-pill fw-bold text-white shadow-sm px-4 py-2" style="@("background-color: " + Model.ThemeColor + "; border-color: " + Model.ThemeColor + ";")">
                        <i class="bi bi-send-check me-1"></i> Dispatch Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --course-theme: @Html.Raw(Model.ThemeColor);
    }

    .custom-radio-card {
        transition: all 0.2s ease;
    }

        .custom-radio-card:hover {
            border-color: var(--course-theme) !important;
            background-color: #f8f9fa;
        }

    .custom-check-row {
        transition: background-color 0.15s;
    }

        .custom-check-row:hover {
            background-color: #f1f5f9;
        }

    .custom-scroll {
        max-height: 180px;
        overflow-y: auto;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const radioNew = document.getElementById("radioNew");
            const radioExisting = document.getElementById("radioExisting");
            const newTeamPanel = document.getElementById("newTeamPanel");
            const existingTeamPanel = document.getElementById("existingTeamPanel");

            function togglePanels() {
                if (radioNew.checked) {
                    newTeamPanel.style.display = "block";
                    existingTeamPanel.style.display = "none";
                } else {
                    newTeamPanel.style.display = "none";
                    existingTeamPanel.style.display = "block";
                }
            }

            radioNew.addEventListener("change", togglePanels);
            radioExisting.addEventListener("change", togglePanels);
        });

        async function attemptTeamDelete() {
            const dropdown = document.getElementById('teamSelectDropdown');
            const teamId = dropdown.value;

            if (!teamId) {
                alert("Please select a team from the dropdown first.");
                return;
            }

            if (confirm("Are you sure you want to completely delete this team?")) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('teamId', teamId);
                formData.append('__RequestVerificationToken', token);

                try {
                    const response = await fetch('/Team/DeleteTeamSafe', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        dropdown.querySelector(`option[value="${teamId}"]`).remove();
                        alert("Team successfully deleted.");
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert("An error occurred while deleting the team.");
                }
            }
        }
    </script>
}