@model ResearchProjectManager.ViewModels.TaskAssignmentListViewModel

@{
    ViewData["Title"] = "My Course Assignments";

    var activeAssignments = Model.Assignments?.Where(a => !a.Grade.HasValue && a.TaskStatus != ResearchProjectManager.Enums.TaskStatus.Completed).ToList() ?? new List<ResearchProjectManager.Models.TaskAssignment>();
    var finishedAssignments = Model.Assignments?.Where(a => !a.Grade.HasValue && a.TaskStatus == ResearchProjectManager.Enums.TaskStatus.Completed).ToList() ?? new List<ResearchProjectManager.Models.TaskAssignment>();
    var gradedAssignments = Model.Assignments?.Where(a => a.Grade.HasValue).ToList() ?? new List<ResearchProjectManager.Models.TaskAssignment>();
}

<style>
    .assignments-header-card {
        border-top: 10px solid @Model.ThemeColor !important;
        background: linear-gradient(135deg, #2D3748 0%, #4a5568 100%);
    }

    .assignment-row {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #edf2f7;
        cursor: pointer;
    }

        .assignment-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
            background-color: #ffffff;
            border-color: #e2e8f0;
        }

    .nav-tabs .nav-link {
        color: #6c757d;
        border-radius: 0.5rem 0.5rem 0 0;
        border: 1px solid transparent;
    }

        .nav-tabs .nav-link.active {
            color: @Model.ThemeColor;
            font-weight: bold;
            border-color: #dee2e6 #dee2e6 #fff !important;
            border-bottom: 3px solid @Model.ThemeColor !important;
            background-color: #f8f9fa;
        }

    @@keyframes brief-glow {
        0% {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.4);
        }

        100% {
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .custom-search {
        border-radius: 0.375rem;
    }

        .custom-search:focus-within {
            animation: brief-glow 0.25s ease-out forwards !important;
        }

        .custom-search .form-control:focus {
            box-shadow: none !important;
            border-color: #dee2e6 !important;
        }

        .custom-search .input-group-text, .custom-search .form-control {
            border-color: #dee2e6 !important;
        }
</style>

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none text-muted fw-medium custom-hover-link">
            <i class="bi bi-arrow-left me-1"></i> Back to Course Overview
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">

        <div class="card-header text-white px-4 py-4 assignments-header-card border-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="mb-1 fw-bold"><i class="bi bi-person-workspace me-2"></i> My Assignments</h2>
                    <p class="mb-0 text-white-50">Track your active tasks and review completed work.</p>
                </div>

                <div class="input-group shadow-sm custom-search" style="width: 250px;">
                    <span class="input-group-text bg-white text-dark border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="assignmentSearch" class="form-control border-start-0 ps-0 shadow-none text-dark" placeholder="Search assignments..." autocomplete="off">
                </div>
            </div>
        </div>

        <div class="bg-white px-4 pt-3 border-bottom">
            <ul class="nav nav-tabs border-bottom-0 gap-2 mb-0" id="assignmentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active px-4 py-2" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                        Active Assignments <span class="badge bg-secondary ms-1">@activeAssignments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-4 py-2" id="finished-tab" data-bs-toggle="tab" data-bs-target="#finished" type="button" role="tab">
                        Finished Assignments <span class="badge bg-success ms-1">@finishedAssignments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-4 py-2" id="graded-tab" data-bs-toggle="tab" data-bs-target="#graded" type="button" role="tab">
                        Graded Assignments <span class="badge bg-primary ms-1">@gradedAssignments.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4 pt-3 pb-3 bg-light">
            <div class="tab-content" id="assignmentTabsContent">

                <div class="tab-pane fade show active" id="active" role="tabpanel">
                    @await Html.PartialAsync("Partials/_ActiveAssignmentsTabPartial", activeAssignments)
                </div>

                <div class="tab-pane fade" id="finished" role="tabpanel">
                    @await Html.PartialAsync("Partials/_FinishedAssignmentsTabPartial", finishedAssignments)
                </div>

                <div class="tab-pane fade" id="graded" role="tabpanel">
                    @await Html.PartialAsync("Partials/_GradedAssignmentsTabPartial", gradedAssignments)
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('assignmentSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.sortable-assignment');

            rows.forEach(row => {
                const assignmentName = row.getAttribute('data-name').toLowerCase();
                if (assignmentName.includes(searchTerm)) {
                    row.classList.remove('d-none');
                } else {
                    row.classList.add('d-none');
                }
            });
        });
    </script>
}