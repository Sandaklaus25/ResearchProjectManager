@model ResearchProjectManager.ViewModels.CourseMemberListViewModel

@{
    ViewData["Title"] = "Course Members";
}
@functions {
    public bool CanManageUser(ResearchProjectManager.ViewModels.CourseMemberListViewModel model, IList<string> targetRoles, int targetId, int ownerId)
    {
        if (targetId == model.CurrentUserId || targetId == ownerId) return false;
        if (model.IsCurrentUserOwner) return true;
        if (model.CurrentUserRole == "Instructor" && !targetRoles.Contains("Instructor")) return true;
        if (model.CurrentUserRole == "TA" && targetRoles.Contains("Student") && !targetRoles.Contains("Instructor") && !targetRoles.Contains("TA")) return true;
        return false;
    }
}

<style>
    .members-header-card {
        border-top: 10px solid @Model.ThemeColor !important;
        background: linear-gradient(135deg, #2D3748 0%, #4a5568 100%);
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8fafc;
        color: #1a202c;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0,0,0,.125);
    }

    .avatar-circle {
        width: 38px;
        height: 38px;
        background-color: #e2e8f0;
        color: #4a5568;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 600;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a asp-controller="Course" asp-action="Details" asp-route-id="@(Model.CourseId)" class="text-decoration-none text-muted fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Back to Course Overview
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header text-white px-4 py-4 members-header-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1 fw-bold"><i class="bi bi-people me-2"></i> Course Members</h2>
                    <p class="mb-0 text-white-50">View course instructors, teaching assistants, and enrolled students.</p>
                </div>
            </div>
        </div>
        <!-- Instructors  -->
        <div class="card-body p-4 bg-white">
            <div class="accordion" id="rosterAccordion">

                <div class="accordion-item border-0 mb-3 shadow-sm rounded-4 overflow-hidden">
                    <h2 class="accordion-header" id="headingInstructors">
                        <button class="accordion-button fw-bold px-4 py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInstructors" aria-expanded="true" aria-controls="collapseInstructors">
                            <i class="bi bi-mortarboard-fill text-primary me-2 fs-5"></i> Instructors <span class="badge bg-primary rounded-pill ms-2">@(Model.Instructors?.Count ?? 0)</span>
                        </button>
                    </h2>
                    <div id="collapseInstructors" class="accordion-collapse collapse show" aria-labelledby="headingInstructors" data-bs-parent="#rosterAccordion">
                        <div class="accordion-body px-4 py-3 bg-white">
                            @if (Model.Instructors == null || !Model.Instructors.Any())
                            {
                                <p class="text-muted mb-0 py-2">No instructors listed.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var user in Model.Instructors)
                                    {
                                        <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">@user.UserName?.Substring(0, 1).ToUpper()</div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">
                                                        @user.UserName
                                                        @if (user.Id == Model.OwnerId)
                                                        {
                                                            <span class="text-muted fw-normal fs-6 ms-1">(Owner)</span>
                                                        }
                                                    </h6>
                                                    <small class="text-muted">@user.Email</small>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border rounded-pill px-3">Lead Instructor</span>

                                                @if (CanManageUser(Model, new List<string> { "Instructor" }, user.Id, Model.IsCurrentUserOwner ? Model.CurrentUserId : 0))
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Kick this member? They will be removed from all active course teams.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Kick" />
                                                                    <button type="submit" class="dropdown-item text-warning fw-medium"><i class="bi bi-box-arrow-right me-2"></i> Kick</button>
                                                                </form>
                                                            </li>
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Ban this member? They will not be able to rejoin.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Ban" />
                                                                    <button type="submit" class="dropdown-item text-danger fw-medium"><i class="bi bi-slash-circle me-2"></i> Ban</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- TAs  -->
                <div class="accordion-item border-0 mb-3 shadow-sm rounded-4 overflow-hidden">
                    <h2 class="accordion-header" id="headingAssistants">
                        <button class="accordion-button collapsed fw-bold px-4 py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAssistants" aria-expanded="false" aria-controls="collapseAssistants">
                            <i class="bi bi-person-badge-fill text-warning me-2 fs-5"></i> Teaching Assistants <span class="badge bg-secondary rounded-pill ms-2">@(Model.Assistants?.Count ?? 0)</span>
                        </button>
                    </h2>
                    <div id="collapseAssistants" class="accordion-collapse collapse" aria-labelledby="headingAssistants" data-bs-parent="#rosterAccordion">
                        <div class="accordion-body px-4 py-3 bg-white">
                            @if (Model.Assistants == null || !Model.Assistants.Any())
                            {
                                <p class="text-muted mb-0 py-2">No assistants assigned to this course.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var user in Model.Assistants)
                                    {
                                        <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">@user.UserName?.Substring(0, 1).ToUpper()</div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@user.UserName </h6>
                                                    <small class="text-muted">@user.Email</small>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-muted border rounded-pill px-3">Assistant</span>

                                                @if (CanManageUser(Model, new List<string> { "TA" }, user.Id, Model.IsCurrentUserOwner ? Model.CurrentUserId : 0))
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Kick this member? They will be removed from all active course teams.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Kick" />
                                                                    <button type="submit" class="dropdown-item text-warning fw-medium"><i class="bi bi-box-arrow-right me-2"></i> Kick</button>
                                                                </form>
                                                            </li>
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Ban this member? They will not be able to rejoin.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Ban" />
                                                                    <button type="submit" class="dropdown-item text-danger fw-medium"><i class="bi bi-slash-circle me-2"></i> Ban</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- Students  -->
                <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden">
                    <h2 class="accordion-header" id="headingStudents">
                        <button class="accordion-button collapsed fw-bold px-4 py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStudents" aria-expanded="false" aria-controls="collapseStudents">
                            <i class="bi bi-people-fill text-success me-2 fs-5"></i> Enrolled Students <span class="badge bg-success rounded-pill ms-2">@(Model.Students?.Count ?? 0)</span>
                        </button>
                    </h2>
                    <div id="collapseStudents" class="accordion-collapse collapse" aria-labelledby="headingStudents" data-bs-parent="#rosterAccordion">
                        <div class="accordion-body px-4 py-3 bg-white">
                            @if (Model.Students == null || !Model.Students.Any())
                            {
                                <p class="text-muted mb-0 py-2">No students enrolled yet.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var user in Model.Students)
                                    {
                                        <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">@user.UserName?.Substring(0, 1).ToUpper()</div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@user.UserName</h6>
                                                    <small class="text-muted">@user.Email</small>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-success border rounded-pill px-3">Student</span>

                                                @if (CanManageUser(Model, new List<string> { "Student" }, user.Id, Model.IsCurrentUserOwner ? Model.CurrentUserId : 0))
                                                {
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Kick this member? They will be removed from all active course teams.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Kick" />
                                                                    <button type="submit" class="dropdown-item text-warning fw-medium"><i class="bi bi-box-arrow-right me-2"></i> Kick</button>
                                                                </form>
                                                            </li>
                                                            <li>
                                                                <form asp-action="ManageMemberStatus" method="post" onsubmit="return confirm('Ban this member? They will not be able to rejoin.');">
                                                                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                                    <input type="hidden" name="targetUserId" value="@user.Id" />
                                                                    <input type="hidden" name="actionType" value="Ban" />
                                                                    <button type="submit" class="dropdown-item text-danger fw-medium"><i class="bi bi-slash-circle me-2"></i> Ban</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- Banned Users -->
                @if (Model.IsCurrentUserOwner || Model.CurrentUserRole.Equals("Instructor") || Model.CurrentUserRole.Equals("TA"))
                {
                    <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden mt-3">
                        <h2 class="accordion-header" id="headingBanned">
                            <button class="accordion-button collapsed fw-bold px-4 py-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBanned" aria-expanded="false" aria-controls="collapseBanned">
                                <i class="bi bi-slash-circle-fill text-danger me-2 fs-5"></i> Banned Users <span class="badge bg-danger rounded-pill ms-2">@(Model.BannedUsers?.Count ?? 0)</span>
                            </button>
                        </h2>
                        <div id="collapseBanned" class="accordion-collapse collapse" aria-labelledby="headingBanned" data-bs-parent="#rosterAccordion">
                            <div class="accordion-body px-4 py-3 bg-white">
                                @if (Model.BannedUsers == null || !Model.BannedUsers.Any())
                                {
                                    <p class="text-muted mb-0 py-2">No users are currently banned.</p>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var user in Model.BannedUsers)
                                        {
                                            <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0 opacity-75">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="avatar-circle bg-danger text-white">@user.UserName?.Substring(0, 1).ToUpper()</div>
                                                    <div>
                                                        <h6 class="mb-0 fw-bold text-dark text-decoration-line-through">@user.UserName</h6>
                                                        <small class="text-danger">Banned</small>
                                                    </div>
                                                </div>

                                                
                                                @if (Model.IsCurrentUserOwner || Model.CurrentUserRole.Equals("Instructor"))
                                                {
                                                    <form asp-action="UnbanMember" method="post" onsubmit="return confirm('Unban this user? They will need the code to rejoin.');">
                                                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                        <input type="hidden" name="targetUserId" value="@user.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">Unban</button>
                                                    </form>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>