@model ResearchProjectManager.ViewModels.CoursesViewModel

@{
    ViewData["Title"] = "Find Courses";
}
<style>
    .course-card {
        min-height: 240px;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    /* Search Bar CSS */
    @@keyframes brief-glow {
        0% {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.4);
        }

        100% {
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .custom-search {
        border-radius: 0.375rem;
    }

        .custom-search:focus-within {
            animation: brief-glow 0.25s ease-out forwards !important;
        }

        .custom-search .form-control:focus {
            box-shadow: none !important;
            border-color: #dee2e6 !important;
        }

        .custom-search .input-group-text, .custom-search .form-control {
            border-color: #dee2e6 !important;
        }

    .desc-scroll {
        max-height: 65px;
        overflow-y: auto;
        scrollbar-width: thin;
        position: relative;
        z-index: 2;
    }

        .desc-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .desc-scroll::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 5px;
        }
</style>
<div class="container py-4">
    <!-- Join By Code Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-compass text-primary me-2"></i>Explore & Join Courses
            </h2>
            <p class="text-muted mb-0">Browse available public courses or enter an exclusive access code to join private ones.</p>
        </div>
        <div class="col-md-5">
            <div class="card shadow-sm border-0 bg-white p-3">
                <form asp-action="JoinByCourseCode" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-8">
                        <input type="text" name="joinCode" class="form-control" placeholder="Enter 9-char code..." required autocomplete="off" />
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Join
                        </button>
                    </div>
                </form>
                @if (TempData["Error"] != null)
                {
                    <div class="text-danger small mt-2">
                        <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-top pt-4">
        <h3 class="fw-bold text-dark mb-0">Public Courses Directory</h3>

        <div class="input-group shadow-sm custom-search" style="width: 320px;">
            <span class="input-group-text bg-white text-muted border-end-0">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="courseSearch" class="form-control border-start-0 ps-0 shadow-none" placeholder="Search public courses...">
        </div>
    </div>

    @if (!Model.AllCourses.Any())
    {
        <div class="alert alert-light border shadow-sm text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-secondary fw-semibold">No public courses available right now.</h5>
            <p class="text-muted small mb-0">Check back later or use a private access code above to join a course.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="publicCoursesContainer">
            @foreach (var course in Model.AllCourses)
            {
                int memberCount = Model.StudentCounts.ContainsKey(course.Id) ? Model.StudentCounts[course.Id] : 0;
                string themeColorHex = ResearchProjectManager.Enums.CourseTheme.Colors.ContainsKey(course.Color) ? ResearchProjectManager.Enums.CourseTheme.Colors[course.Color] : "#0d6efd";

                <div class="col sortable-course" data-name="@course.Name">
                    <div class="card h-100 shadow-sm border-0 course-card position-relative overflow-hidden"
                         style="border-top: 20px solid @themeColorHex !important; border-bottom: 7px solid @themeColorHex !important;">

                        <div class="card-body d-flex flex-column px-4 pt-3 pb-3">

                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-success"><i class="bi bi-globe"></i> Public</span>
                            </div>

                            <h4 class="card-title fw-bold mt-1 mb-1 text-truncate" style="max-width: 100%;">
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="text-decoration-none text-dark stretched-link">
                                    @course.Name
                                </a>
                            </h4>

                            <div class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                Members: @memberCount
                            </div>

                           
                            <div class="desc-scroll card-text small flex-grow-1 mb-3 pe-2">
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="text-decoration-none text-muted custom-hover-link d-block">
                                    @if (!string.IsNullOrEmpty(course.Description))
                                    {
                                        @course.Description
                                    }
                                    else
                                    {
                                        <span class="fst-italic">No description provided for this course.</span>
                                    }
                                </a>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">

                                    <div class="text-muted small d-flex align-items-center" style="position: relative; z-index: 2;">
                                        <i class="bi bi-person-circle fs-4" style="margin-right:10px;"></i>
                                        <span>Owner:<br><strong>@(course.Owner?.UserName ?? "Unknown")</strong></span>
                                    </div>

                                    <div style="position: relative; z-index: 2;" class="d-flex gap-1">
                                       
                                        @if (User.IsInRole("Student"))
                                        {
                                            <form asp-action="JoinByCourseCode" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="joinCode" value="@course.SpecialCode" />
                                                <button type="submit" class="btn btn-sm btn-success px-3 py-2 fw-semibold">
                                                    <i class="bi bi-box-arrow-in-right me-1"></i> Join Course
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary px-3 py-2 fw-semibold">
                                                <i class="bi bi-eye me-1"></i> View Details
                                            </a>
                                        }
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('courseSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.sortable-course');

            cards.forEach(card => {
                const courseName = card.getAttribute('data-name').toLowerCase();
                if (courseName.includes(searchTerm)) {
                    card.classList.remove('d-none');
                } else {
                    card.classList.add('d-none');
                }
            });
        });
    </script>
}