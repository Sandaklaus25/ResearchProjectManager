@model ResearchProjectManager.ViewModels.CoursesViewModel

@{
    ViewData["Title"] = "Courses";
}
<style>
    .course-card {
        min-height: 240px;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .card-actions {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0;
    }

        .card-actions form {
            margin: 0;
            padding: 0;
        }

        .card-actions .btn {
            border-radius: 0;
        }

        .card-actions > a:first-child {
            border-top-left-radius: 0.25rem;
            border-bottom-left-radius: 0.25rem;
        }

        .card-actions form:last-child button {
            border-top-right-radius: 0.25rem;
            border-bottom-right-radius: 0.25rem;
        }

    .sort-btn {
        width: 110px;
    }

    .new-course-btn {
        padding: 0.375rem 0.75rem;
        width: 145px;
        text-align: center;
    }

    @@keyframes brief-glow {
        0% {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.4);
        }

        100% {
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .btn:focus, .btn:active:focus {
        animation: brief-glow 0.25s ease-out forwards !important;
        outline: none !important;
    }

    .custom-search {
        border-radius: 0.375rem;
    }

        .custom-search:focus-within {
            animation: brief-glow 0.25s ease-out forwards !important;
        }

        .custom-search .form-control:focus {
            box-shadow: none !important;
            border-color: #dee2e6 !important;
        }

        .custom-search .input-group-text, .custom-search .form-control {
            border-color: #dee2e6 !important;
        }

    /* Keeps description fixed and adds a clean scrollbar */
    .desc-scroll {
        max-height: 65px;
        overflow-y: auto;
        scrollbar-width: thin; /* Firefox */
        /* These two lines pull the scroll box above the stretched-link overlay */
        position: relative;
        z-index: 2;
    }

        .desc-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .desc-scroll::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 5px;
        }
</style>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <h2 class="mb-0"><i class="bi bi-journal-bookmark text-primary"></i> Course Directory</h2>

        <div class="d-flex gap-3 align-items-center flex-wrap">

            <div class="input-group shadow-sm custom-search" style="width: 320px;">
                <span class="input-group-text bg-white text-muted border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="courseSearch" class="form-control border-start-0 ps-0" placeholder="Search courses by name...">
            </div>

            <div class="btn-group shadow-sm" role="group">
                <button id="btn-name" class="btn btn-outline-primary sort-btn active-sort" onclick="sortCourses('name')">
                    Name <i class="bi bi-arrow-down"></i>
                </button>
                <button id="btn-privacy" class="btn btn-outline-primary sort-btn" onclick="sortCourses('privacy')">
                    Privacy <i></i>
                </button>
            </div>
            @if(User.IsInRole("Instructor"))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm text-nowrap new-course-btn">
                <i class="bi bi-plus-circle" style="margin-right:5px"></i> New Course
            </a>
            }
        </div>
    </div>

    <div class="row" id="courseContainer">
        @foreach (var item in Model.AllCourses)
        {
            int memberCount = Model.StudentCounts.ContainsKey(item.Id) ? Model.StudentCounts[item.Id] : 0;
            string themeColorHex = ResearchProjectManager.Enums.CourseTheme.Colors.ContainsKey(item.Color) ? ResearchProjectManager.Enums.CourseTheme.Colors[item.Color] : "#0d6efd";

            <div class="col-md-6 col-lg-4 mb-4 sortable-course"
                 data-name="@item.Name"
                 data-privacy="@item.IsPrivate">

                <div class="card h-100 shadow-sm border-0 course-card" style="border-top: 20px solid @themeColorHex !important; border-bottom: 7px solid @themeColorHex !important">
                    <div class="card-body d-flex flex-column px-4 pt-3 pb-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                @if (item.IsPrivate)
                                {
                                    <span class="badge bg-dark"><i class="bi bi-lock-fill"></i> Private</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-globe"></i> Public</span>
                                }
                            </div>

                            @if (User.IsInRole("Instructor") || User.IsInRole("TA"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 32px; border-radius: 20px; position: relative; z-index: 3;" 
                                    onclick="copyCourseCode('@item.SpecialCode', this)" title="Copy Access Code">
                                    <i class="bi bi-link fs-5"></i>
                                </button>
                            }
                            </div>

                        <h4 class="card-title fw-bold mt-1 mb-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark stretched-link">
                                @item.Name
                            </a>
                        </h4>

                        <div class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                            Members: @memberCount
                        </div>

                        <div class="desc-scroll card-text small flex-grow-1 mb-3 pe-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-muted custom-hover-link d-block">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @item.Description
                                }
                                else
                                {
                                    <span class="fst-italic">No description provided for this course.</span>
                                }
                            </a>
                        </div>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">

                                <div class="text-muted small d-flex align-items-center">
                                    <i class="bi bi-person-circle fs-4" style="margin-right:10px;"></i>
                                    <span>Owner:<br><strong>@(item.Owner?.UserName ?? "Unknown")</strong></span>
                                </div>

                                @{
                                    bool isOwner = item.Owner?.UserName == User.Identity?.Name;
                                }

                                <div class="card-actions">
                                    
                                    @if (User.IsInRole("Instructor") && !isOwner || User.IsInRole("TA"))
                                    {
                                        <a asp-controller="TaskAssignment" asp-action="Index" asp-route-courseId="@item.Id" class="btn btn-sm btn-outline-primary px-3 py-1 fw-medium" title="View All Assignments">
                                            <i class="bi bi-journal-text me-1"></i> Assignments
                                        </a>
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        <a asp-controller="TaskAssignment" asp-action="MyCourseAssignments" asp-route-courseId="@item.Id" class="btn btn-sm btn-outline-primary px-3 py-1 fw-medium" title="My Assignments">
                                            <i class="bi bi-journal-text me-1"></i> Assignments
                                        </a>
                                    }

                                   
                                    @if (isOwner)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-3 py-1 fw-medium" title="Edit">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this course?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1 fw-medium" title="Delete">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Leave" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to leave this course? You will lose access to its workspace.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1 fw-medium" title="Leave Course">
                                                <i class="bi bi-box-arrow-left me-1"></i> Leave
                                            </button>
                                        </form>
                                    }
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const courseSortDirections = { name: 1, privacy: 1 };

        function sortCourses(criteria) {
            const container = document.getElementById('courseContainer');
            const cards = Array.from(container.getElementsByClassName('sortable-course'));

            courseSortDirections[criteria] *= -1;
            const direction = courseSortDirections[criteria];

            cards.sort((a, b) => {
                let valA, valB;

                if (criteria === 'name') {
                    valA = a.getAttribute('data-name').toLowerCase();
                    valB = b.getAttribute('data-name').toLowerCase();
                } else if (criteria === 'privacy') {
                    valA = a.getAttribute('data-privacy');
                    valB = b.getAttribute('data-privacy');
                }

                if (valA > valB) return 1 * direction;
                if (valA < valB) return -1 * direction;
                return 0;
            });

            container.innerHTML = '';
            cards.forEach(card => container.appendChild(card));

            updateCourseUI(criteria, direction);
        }

        function updateCourseUI(activeCriteria, direction) {
            ['name', 'privacy'].forEach(c => {
                const btn = document.getElementById('btn-' + c);
                const icon = btn.querySelector('i');

                if (c === activeCriteria) {
                    btn.classList.replace('btn-outline-primary', 'btn-primary');
                    icon.className = direction === 1 ? "bi bi-arrow-up" : "bi bi-arrow-down";
                } else {
                    btn.classList.replace('btn-primary', 'btn-outline-primary');
                    icon.className = "";
                }
            });
        }

        document.getElementById('courseSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.sortable-course');

            cards.forEach(card => {
                const courseName = card.getAttribute('data-name').toLowerCase();
                if (courseName.includes(searchTerm)) {
                    card.classList.remove('d-none');
                } else {
                    card.classList.add('d-none');
                }
            });
        });
        function copyCourseCode(code, btn) {
            event.preventDefault(); 
    
            navigator.clipboard.writeText(code).then(() => {
                
                btn.innerHTML = '<i class="bi bi-check2-all fs-6"></i>';
                btn.classList.replace('btn-outline-primary', 'btn-success');
                btn.classList.add('text-white');
        
                setTimeout(() => {
                    btn.innerHTML = '<i class="bi bi-link fs-5"></i>';
                    btn.classList.replace('btn-success', 'btn-outline-primary');
                    btn.classList.remove('text-white');
                    }, 2000);
                });
            }
    </script>
}