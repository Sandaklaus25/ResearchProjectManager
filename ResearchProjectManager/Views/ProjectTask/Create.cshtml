@model ResearchProjectManager.ViewModels.ProjectTaskCreateViewModel

@{
    ViewData["Title"] = "Create General Task";
}

<div class="container mt-4 mb-5" style="max-width: 700px;">
    <div class="mb-3">
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="text-decoration-none text-muted fw-medium custom-hover-link">
            <i class="bi bi-arrow-left me-1"></i> Back to Assignments
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-3" style="border-top: 10px solid @(Model.ThemeColor) !important; background: linear-gradient(to bottom right, #ffffff, #f8fafc);">
        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; background-color: @(Model.ThemeColor); color: white;">
                    <i class="bi bi-file-earmark-plus fs-5"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Create General Task</h3>
                    <p class="text-muted mb-0 small">This task will be assigned to all students in the course.</p>
                </div>
            </div>

            <form asp-action="Create" asp-route-courseId="@Model.CourseId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold text-dark mb-1">Assignment Title <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control bg-light border-0 shadow-none" placeholder="e.g., Week 1: Database Normalization" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold text-dark mb-1">Task Description</label>
                    <textarea asp-for="Description" class="form-control bg-light border-0 shadow-none" rows="5" placeholder="Detail the requirements, deliverables, and instructions for the students..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <div>
                            <label class="form-label fw-semibold text-dark mb-0">Task Steps (Optional)</label>
                            <p class="text-muted small mb-0">Define specific steps for this assignment.</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-medium" onclick="addSubtask()">
                            <i class="bi bi-plus me-1"></i> Add Step
                        </button>
                    </div>

                    <div id="subtaskList" class="d-flex flex-column gap-2"></div>
                </div>

                <div class="alert alert-warning border-0 rounded-3 small d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-3 text-warning"></i>
                    <div>
                        Once created, assignments <strong>cannot be edited</strong>. If you make a mistake, you must delete it (which wipes all student assignments for this task) and recreate it.
                    </div>
                </div>

                <hr class="text-muted opacity-25 my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary rounded-pill fw-medium px-4 py-2">Cancel</a>
                    <button type="submit" class="btn rounded-pill fw-bold text-white shadow-sm px-4 py-2" style="background-color: @(Model.ThemeColor); border-color: @(Model.ThemeColor);">
                        <i class="bi bi-send me-1"></i> Publish Assignment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let subtaskIndex = 0;
        function addSubtask() {
            const container = document.getElementById('subtaskList');
            const row = document.createElement('div');
            row.className = 'd-flex gap-2 align-items-start subtask-row bg-light p-2 rounded-3 border';

            row.innerHTML = `
                        <div class="mt-1 ms-1 text-muted"><i class="bi bi-grip-vertical"></i></div>
                        <div class="flex-grow-1">
                            <input type="text" name="Subtasks[${subtaskIndex}].Name" class="form-control form-control-sm mb-1 fw-bold shadow-none border-secondary border-opacity-25" placeholder="Step Name (e.g., Design the ER Diagram)" required />
                            <input type="text" name="Subtasks[${subtaskIndex}].Description" class="form-control form-control-sm text-muted shadow-none border-secondary border-opacity-25" placeholder="Short description or instructions (optional)..." />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 mt-2 me-1" onclick="this.closest('.subtask-row').remove()" title="Remove step">
                            <i class="bi bi-trash3"></i>
                        </button>
                    `;
            container.appendChild(row);
            subtaskIndex++;
        }
    </script>
}