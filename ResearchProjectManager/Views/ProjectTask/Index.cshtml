@* Display all courses as cards TODO: Edit later currently doing else *@
@if (User.IsInRole("Instructor"))
{
    <div class="col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">All Course Projects</h4>
            </div>
            <div class="card-body">
                @if (Model.AllProjects.Count == 0)
                {
                    <p>No projects created yet. <a asp-controller="ProjectTask" asp-action="Create">Create one now.</a></p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var project in Model.AllProjects)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@project.Name</strong>
                                    <br />
                                    <small class="text-muted">@project.Description</small>
                                </div>
                                <a asp-controller="ProjectTask" asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}