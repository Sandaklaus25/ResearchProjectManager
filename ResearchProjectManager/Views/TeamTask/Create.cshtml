@model ResearchProjectManager.ViewModels.AssignTaskViewModel

@{
    ViewData["Title"] = "Assign Task";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Assign Task: @Model.TaskName</h3>
        </div>
        <div class="card-body">
            
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="ProjectTaskId" />
                
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="Deadline" class="form-label fw-bold">Select Deadline <span class="text-danger">*</span></label>
                        <input asp-for="Deadline" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="Deadline" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold">Select Students for this Group</label>
                        <div class="border rounded p-3" style="max-height: 250px; overflow-y: auto;">
                            
                            @if (Model.AvailableStudents.Any())
                            {
                                @foreach (var student in Model.AvailableStudents)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="SelectedStudentIds" value="@student.Id" id="student_@student.Id" />
                                        <label class="form-check-label" for="student_@student.Id">
                                            @student.Email
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted fst-italic">No students found in the database.</p>
                            }

                        </div>
                        <small class="text-muted">Checked students will be grouped into a single team.</small>
                    </div>
                </div>

                <hr />
                
                <div class="d-flex justify-content-between">
                    <a asp-controller="ProjectTask" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success px-5">Apply Assignment</button>
                </div>
            </form>

        </div>
    </div>
</div>