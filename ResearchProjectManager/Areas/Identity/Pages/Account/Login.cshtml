@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<style>
    .form-floating > label::after {
        background-color: transparent !important;
    }
</style>
<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h2 class="text-center fw-bold mb-4">Welcome Back</h2>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email or Username</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label text-muted small" asp-for="Input.RememberMe">
                        Remember me
                    </label>
                </div>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill fw-bold mb-3">Log in</button>

            <div class="text-center mt-3">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none small text-muted">Don't have an account? <span class="text-primary fw-semibold">Register</span></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}